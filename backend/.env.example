# Copy this file to ".env" and fill in the password you set in pgAdmin.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PGADMIN_PASSWORD@localhost:5432/raja_trusted_db

# Generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256

# Short login session (minutes) vs "Remember me" session (days)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REMEMBER_ME_EXPIRE_DAYS=30

# One-time secret code required to register an admin account.
ADMIN_SIGNUP_CODE=change_this_admin_code

# Allowed frontend origin(s), comma separated
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5173,http://localhost:5173
